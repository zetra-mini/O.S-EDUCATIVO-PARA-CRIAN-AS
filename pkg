#!/usr/bin/env bash
# ==============================================================================
# 🚀 J.A.R.V.I.S. KIDS OS — GERENCIADOR & INSTALADOR UNIVERSAL: PKG
# Utilitário Oficial para Linux (antiX, xlinux, Debian, Ubuntu, Alpine, Termux, Void)
# Otimizado para Hardware Modesto (Asus Eee PC, Acer Aspire One, Intel Atom N450/N270)
# ==============================================================================

set -e

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # Sem cor

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ACTION="${1:-install}"
PORT="${JARVIS_PORT:-8000}"

banner() {
  echo -e "${CYAN}==================================================================${NC}"
  echo -e "${CYAN}   🚀 J.A.R.V.I.S. KIDS OS — GERENCIADOR DE PACOTES 'PKG'         ${NC}"
  echo -e "${CYAN}   Sistema Educativo Stark para Netbooks & Desktops Leves        ${NC}"
  echo -e "${CYAN}==================================================================${NC}"
}

detect_pkg_manager() {
  if command -v pkg >/dev/null 2>&1 && [ -f /data/data/com.termux/files/usr/bin/pkg 2>/dev/null ]; then
    echo "termux-pkg"
  elif command -v apt-get >/dev/null 2>&1; then
    echo "apt"
  elif command -v apk >/dev/null 2>&1; then
    echo "apk"
  elif command -v pacman >/dev/null 2>&1; then
    echo "pacman"
  elif command -v xbps-install >/dev/null 2>&1; then
    echo "xbps"
  elif command -v pkg >/dev/null 2>&1; then
    echo "pkg-native"
  else
    echo "unknown"
  fi
}

cmd_install() {
  banner
  echo -e "${YELLOW}⚡ [1/6] Detectando ambiente e gerenciador de pacotes...${NC}"
  PM=$(detect_pkg_manager)
  echo -e "   Gerenciador detectado: ${GREEN}${PM}${NC}"

  echo -e "${YELLOW}📦 [2/6] Instalando dependências essenciais do sistema...${NC}"
  case "$PM" in
    apt)
      if [ "$EUID" -eq 0 ]; then
        apt-get update -qq || true
        apt-get install -y python3 python3-pip python3-venv alsa-utils espeak-ng mpg123 unclutter \
          chromium-browser 2>/dev/null || apt-get install -y chromium 2>/dev/null || apt-get install -y firefox-esr 2>/dev/null || true
      else
        sudo apt-get update -qq || true
        sudo apt-get install -y python3 python3-pip python3-venv alsa-utils espeak-ng mpg123 unclutter \
          chromium-browser 2>/dev/null || sudo apt-get install -y chromium 2>/dev/null || sudo apt-get install -y firefox-esr 2>/dev/null || true
      fi
      ;;
    apk)
      if [ "$EUID" -eq 0 ]; then
        apk update || true
        apk add python3 py3-pip py3-virtualenv alsa-utils mpg123 chromium || true
      else
        sudo apk update || true
        sudo apk add python3 py3-pip py3-virtualenv alsa-utils mpg123 chromium || true
      fi
      ;;
    pacman)
      if [ "$EUID" -eq 0 ]; then
        pacman -Sy --noconfirm python python-pip alsa-utils espeak-ng mpg123 chromium || true
      else
        sudo pacman -Sy --noconfirm python python-pip alsa-utils espeak-ng mpg123 chromium || true
      fi
      ;;
    termux-pkg)
      pkg update -y || true
      pkg install -y python alsa-utils mpg123 || true
      ;;
    *)
      echo -e "${YELLOW}   Aviso: Gerenciador padrão não identificado diretamente. Tentando python3 direto...${NC}"
      ;;
  esac

  echo -e "${YELLOW}🐍 [3/6] Configurando ambiente Python de ultra-baixo consumo...${NC}"
  cd "$APP_DIR"
  if [ ! -d "$APP_DIR/venv" ]; then
    python3 -m venv "$APP_DIR/venv" 2>/dev/null || true
  fi

  if [ -f "$APP_DIR/venv/bin/pip" ]; then
    "$APP_DIR/venv/bin/pip" install --upgrade pip --no-cache-dir 2>/dev/null || true
    "$APP_DIR/venv/bin/pip" install microdot bottle edge-tts requests google-genai --no-cache-dir || true
  else
    python3 -m pip install --user --break-system-packages microdot bottle edge-tts requests google-genai --no-cache-dir 2>/dev/null || \
    python3 -m pip install --user microdot bottle edge-tts requests google-genai --no-cache-dir 2>/dev/null || true
  fi

  echo -e "${YELLOW}⚡ [4/6] Aplicando otimizações para Asus One / Acer One (Intel Atom N450)...${NC}"
  # Ajuste de Swappiness leve (15) para evitar engasgos em HDs lentos de netbooks
  if [ "$EUID" -eq 0 ]; then
    if [ -d /etc/sysctl.d ]; then
      echo "vm.swappiness=15" > /etc/sysctl.d/99-jarvis-kids.conf 2>/dev/null || true
      echo "vm.vfs_cache_pressure=50" >> /etc/sysctl.d/99-jarvis-kids.conf 2>/dev/null || true
      sysctl -p /etc/sysctl.d/99-jarvis-kids.conf >/dev/null 2>&1 || true
    fi
  elif command -v sudo >/dev/null 2>&1; then
    sudo sh -c 'echo "vm.swappiness=15" > /etc/sysctl.d/99-jarvis-kids.conf' 2>/dev/null || true
    sudo sysctl -p /etc/sysctl.d/99-jarvis-kids.conf >/dev/null 2>&1 || true
  fi

  echo -e "${YELLOW}🔗 [5/6] Instalando comando global 'pkg' e 'jarvis-kids'...${NC}"
  # Link simbólico para o comando pkg poder ser chamado de qualquer pasta
  INSTALL_BIN="/usr/local/bin"
  if [ ! -w "$INSTALL_BIN" ] && command -v sudo >/dev/null 2>&1; then
    sudo ln -sf "$APP_DIR/pkg" "$INSTALL_BIN/pkg" 2>/dev/null || true
    sudo ln -sf "$APP_DIR/iniciar_web_kiosk.sh" "$INSTALL_BIN/jarvis-kids" 2>/dev/null || true
  elif [ -w "$INSTALL_BIN" ]; then
    ln -sf "$APP_DIR/pkg" "$INSTALL_BIN/pkg" 2>/dev/null || true
    ln -sf "$APP_DIR/iniciar_web_kiosk.sh" "$INSTALL_BIN/jarvis-kids" 2>/dev/null || true
  else
    mkdir -p "$HOME/.local/bin"
    ln -sf "$APP_DIR/pkg" "$HOME/.local/bin/pkg" 2>/dev/null || true
    ln -sf "$APP_DIR/iniciar_web_kiosk.sh" "$HOME/.local/bin/jarvis-kids" 2>/dev/null || true
  fi

  # Cria lançador de desktop
  DESKTOP_DIR="$HOME/Desktop"
  [ ! -d "$DESKTOP_DIR" ] && DESKTOP_DIR="$HOME/Área de Trabalho"
  if [ -d "$DESKTOP_DIR" ]; then
    cat > "$DESKTOP_DIR/JARVIS_Kids.desktop" << EOF
[Desktop Entry]
Name=J.A.R.V.I.S. Kids OS
Comment=Sistema Educativo Infantil Stark
Exec=$APP_DIR/iniciar_web_kiosk.sh
Icon=$APP_DIR/static/icons/icon-192.png
Terminal=false
Type=Application
Categories=Education;KidsGame;
EOF
    chmod +x "$DESKTOP_DIR/JARVIS_Kids.desktop" 2>/dev/null || true
  fi

  chmod +x "$APP_DIR/pkg" "$APP_DIR"/*.sh 2>/dev/null || true

  echo -e "${YELLOW}🎉 [6/6] Verificando integridade da instalação...${NC}"
  echo -e "${GREEN}==================================================================${NC}"
  echo -e "${GREEN}   ✅ INSTALAÇÃO CONCLUÍDA COM SUCESSO!                          ${NC}"
  echo -e "${GREEN}==================================================================${NC}"
  echo -e "Você agora pode usar o comando ${BOLD}pkg${NC} para controlar o sistema:\n"
  echo -e "   ${CYAN}pkg start${NC}    ➔ Iniciar o J.A.R.V.I.S. Kids OS em tela cheia"
  echo -e "   ${CYAN}pkg status${NC}   ➔ Verificar integridade, porta e consumo de RAM"
  echo -e "   ${CYAN}pkg stop${NC}     ➔ Parar o servidor"
  echo -e "   ${CYAN}pkg update${NC}   ➔ Atualizar o sistema com as últimas novidades"
  echo -e "\nPara abrir agora mesmo, execute: ${BOLD}./pkg start${NC} ou ${BOLD}pkg start${NC}\n"
}

cmd_start() {
  echo -e "${CYAN}🚀 Iniciando o J.A.R.V.I.S. Kids OS na porta ${PORT}...${NC}"
  cd "$APP_DIR"
  
  # Determina python
  if [ -f "$APP_DIR/venv/bin/python" ]; then
    PY="$APP_DIR/venv/bin/python"
  else
    PY="python3"
  fi

  # Se o servidor não estiver rodando, inicia em background
  if ! pgrep -f "run_server.py $PORT" >/dev/null 2>&1; then
    nohup "$PY" "$APP_DIR/run_server.py" "$PORT" > "$APP_DIR/jarvis_server.log" 2>&1 &
    sleep 1.8
  fi

  # Abre o quiosque
  if [ -f "$APP_DIR/iniciar_web_kiosk.sh" ]; then
    bash "$APP_DIR/iniciar_web_kiosk.sh" "$PORT" &
  elif command -v chromium-browser >/dev/null 2>&1; then
    chromium-browser --kiosk --disable-gpu --disable-dev-shm-usage --app="http://127.0.0.1:${PORT}" &
  elif command -v chromium >/dev/null 2>&1; then
    chromium --kiosk --disable-gpu --disable-dev-shm-usage --app="http://127.0.0.1:${PORT}" &
  elif command -v firefox >/dev/null 2>&1; then
    firefox --kiosk "http://127.0.0.1:${PORT}" &
  else
    echo -e "${GREEN}Servidor ativo em http://127.0.0.1:${PORT}${NC}"
    echo -e "Abra no navegador de sua preferência."
  fi
}

cmd_stop() {
  echo -e "${YELLOW}🛑 Encerrando o J.A.R.V.I.S. Kids OS...${NC}"
  pkill -f "run_server.py $PORT" 2>/dev/null || true
  pkill -f "run_server.py" 2>/dev/null || true
  echo -e "${GREEN}✅ Servidor encerrado.${NC}"
}

cmd_status() {
  banner
  echo -e "🔍 Verificando status do sistema:"
  if pgrep -f "run_server.py" >/dev/null 2>&1; then
    PID=$(pgrep -f "run_server.py" | head -n1)
    MEM=$(ps -o rss= -p "$PID" 2>/dev/null | awk '{printf "%.1f MB", $1/1024}' || echo "N/A")
    echo -e "   Servidor: ${GREEN}ATIVO (PID: ${PID})${NC}"
    echo -e "   Porta:    ${GREEN}http://127.0.0.1:${PORT}${NC}"
    echo -e "   Memória:  ${GREEN}${MEM}${NC}"
  else
    echo -e "   Servidor: ${RED}PARADO${NC}"
    echo -e "   Dica:     Execute ${CYAN}pkg start${NC} para iniciar."
  fi
}

cmd_update() {
  banner
  echo -e "${YELLOW}🔄 Atualizando o J.A.R.V.I.S. Kids OS para a versão mais recente...${NC}"
  cd "$APP_DIR"
  if [ -d ".git" ]; then
    git pull origin main || true
  else
    echo -e "${YELLOW}Repositório Git não detectado. Baixando arquivos mais recentes...${NC}"
  fi
  echo -e "${GREEN}✅ Atualização concluída com sucesso!${NC}"
}

cmd_help() {
  banner
  echo -e "Uso: ${BOLD}pkg <comando>${NC} ou ${BOLD}./pkg <comando>${NC}\n"
  echo -e "Comandos disponíveis:"
  echo -e "  ${CYAN}install${NC}   Instala todas as dependências, atalhos e otimiza o sistema (Padrão)"
  echo -e "  ${CYAN}start${NC}     Inicia o servidor e abre o J.A.R.V.I.S. Kids em tela cheia"
  echo -e "  ${CYAN}stop${NC}      Encerra o servidor com segurança"
  echo -e "  ${CYAN}status${NC}    Exibe o status do servidor, uso de memória RAM e porta"
  echo -e "  ${CYAN}update${NC}    Atualiza o código com a versão mais recente do GitHub"
  echo -e "  ${CYAN}help${NC}      Exibe este menu de ajuda\n"
}

case "$ACTION" in
  install|i|setup)
    cmd_install
    ;;
  start|run|launch)
    cmd_start
    ;;
  stop|kill)
    cmd_stop
    ;;
  status|info)
    cmd_status
    ;;
  update|upgrade)
    cmd_update
    ;;
  help|-h|--help)
    cmd_help
    ;;
  *)
    cmd_help
    ;;
esac
