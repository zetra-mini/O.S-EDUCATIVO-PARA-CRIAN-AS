#!/usr/bin/env bash
# ==============================================================================
# 🚀 J.A.R.V.I.S. KIDS OS — GERENCIADOR & INSTALADOR UNIVERSAL: PKG
# Utilitário Oficial para Linux (antiX, Debian, Ubuntu, Alpine, Termux, VPS, Void)
# Otimizado para Hardware Modesto (Asus Eee PC, Acer Aspire One, Intel Atom) e VPS Nuvem
# ==============================================================================

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # Sem cor

# Resolução canônica de links simbólicos para determinar o diretório real do projeto
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
APP_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

ACTION="${1:-install}"
PORT="${JARVIS_PORT:-8000}"

banner() {
  echo -e "${CYAN}==================================================================${NC}"
  echo -e "${CYAN}   🚀 J.A.R.V.I.S. KIDS OS — GERENCIADOR DE PACOTES 'PKG'         ${NC}"
  echo -e "${CYAN}   Sistema Educativo Stark para Netbooks, PCs & VPS Cloud        ${NC}"
  echo -e "${CYAN}==================================================================${NC}"
}

detect_pkg_manager() {
  if [ -d /data/data/com.termux ] && command -v pkg >/dev/null 2>&1; then
    echo "termux-pkg"
  elif command -v apt-get >/dev/null 2>&1; then
    echo "apt"
  elif command -v apk >/dev/null 2>&1; then
    echo "apk"
  elif command -v pacman >/dev/null 2>&1; then
    echo "pacman"
  elif command -v dnf >/dev/null 2>&1; then
    echo "dnf"
  elif command -v xbps-install >/dev/null 2>&1; then
    echo "xbps"
  else
    echo "generic"
  fi
}

cmd_install() {
  banner
  echo -e "${YELLOW}⚡ [1/6] Detectando ambiente e gerenciador de pacotes...${NC}"
  PM=$(detect_pkg_manager)
  echo -e "   Gerenciador detectado: ${GREEN}${PM}${NC}"

  echo -e "${YELLOW}📦 [2/6] Instalando dependências essenciais do sistema...${NC}"
  case "$PM" in
    apt)
      local APT="apt-get"
      [ "$EUID" -ne 0 ] && APT="sudo apt-get"

      $APT update -qq || true

      # 1. Base Python essencial (obrigatória para o servidor em VPS e Desktop)
      echo -e "   Instalando Python 3, venv e pip..."
      $APT install -y python3 python3-pip python3-venv curl || true

      # 2. Utilitários de áudio leves (opcionais, com tolerância a falhas)
      echo -e "   Instalando suporte de áudio e fala..."
      $APT install -y alsa-utils espeak-ng mpg123 2>/dev/null || true

      # 3. Navegador quiosque (apenas se ambiente gráfico ou desktop estiver disponível)
      if [ -n "$DISPLAY" ]; then
        echo -e "   Ambiente gráfico detectado. Instalando quiosque..."
        $APT install -y unclutter 2>/dev/null || true
        $APT install -y chromium 2>/dev/null || $APT install -y chromium-browser 2>/dev/null || $APT install -y firefox-esr 2>/dev/null || true
      else
        echo -e "   Ambiente Headless / VPS detectado (sem monitor). Omitindo navegador gráfico."
      fi
      ;;
    apk)
      local APK="apk"
      [ "$EUID" -ne 0 ] && APK="sudo apk"
      $APK update || true
      $APK add python3 py3-pip py3-virtualenv curl || true
      $APK add alsa-utils mpg123 2>/dev/null || true
      [ -n "$DISPLAY" ] && $APK add chromium 2>/dev/null || true
      ;;
    pacman)
      local PAC="pacman"
      [ "$EUID" -ne 0 ] && PAC="sudo pacman"
      $PAC -Sy --noconfirm python python-pip curl || true
      $PAC -S --noconfirm alsa-utils espeak-ng mpg123 2>/dev/null || true
      [ -n "$DISPLAY" ] && $PAC -S --noconfirm chromium 2>/dev/null || true
      ;;
    dnf)
      local DNF="dnf"
      [ "$EUID" -ne 0 ] && DNF="sudo dnf"
      $DNF install -y python3 python3-pip curl || true
      $DNF install -y alsa-utils espeak-ng mpg123 2>/dev/null || true
      [ -n "$DISPLAY" ] && $DNF install -y chromium 2>/dev/null || true
      ;;
    termux-pkg)
      pkg update -y || true
      pkg install -y python alsa-utils mpg123 curl || true
      ;;
    *)
      echo -e "${YELLOW}   Aviso: Gerenciador padrão não identificado diretamente. Usando Python do sistema...${NC}"
      ;;
  esac

  echo -e "${YELLOW}🐍 [3/6] Configurando ambiente Python de ultra-baixo consumo...${NC}"
  cd "$APP_DIR"

  # Se o venv existir mas estiver corrompido (sem pip), recria
  if [ -d "$APP_DIR/venv" ] && [ ! -f "$APP_DIR/venv/bin/pip" ]; then
    echo -e "   Limpando ambiente virtual corrompido..."
    rm -rf "$APP_DIR/venv" 2>/dev/null || true
  fi

  if [ ! -d "$APP_DIR/venv" ]; then
    python3 -m venv "$APP_DIR/venv" 2>/dev/null || true
  fi

  if [ -f "$APP_DIR/venv/bin/pip" ]; then
    echo -e "   Instalando pacotes no ambiente virtual (venv)..."
    "$APP_DIR/venv/bin/pip" install --upgrade pip --no-cache-dir 2>/dev/null || true
    "$APP_DIR/venv/bin/pip" install microdot bottle edge-tts requests google-genai --no-cache-dir || true
  else
    echo -e "   Instalando pacotes com pip global..."
    python3 -m pip install --break-system-packages microdot bottle edge-tts requests google-genai --no-cache-dir 2>/dev/null || \
    python3 -m pip install --user --break-system-packages microdot bottle edge-tts requests google-genai --no-cache-dir 2>/dev/null || \
    python3 -m pip install --user microdot bottle edge-tts requests google-genai --no-cache-dir 2>/dev/null || true
  fi

  echo -e "${YELLOW}⚡ [4/6] Aplicando otimizações de sistema e memória...${NC}"
  # Ajuste de Swappiness leve (15) para evitar engasgos em HDs lentos ou VPS
  if [ -w /proc/sys/vm/swappiness ] 2>/dev/null; then
    sysctl -w vm.swappiness=15 >/dev/null 2>&1 || true
    sysctl -w vm.vfs_cache_pressure=50 >/dev/null 2>&1 || true
  fi

  echo -e "${YELLOW}🔗 [5/6] Instalando comando global 'pkg' e 'jarvis-kids'...${NC}"
  INSTALL_BIN="/usr/local/bin"
  if [ -w "$INSTALL_BIN" ]; then
    ln -sf "$APP_DIR/pkg" "$INSTALL_BIN/pkg" 2>/dev/null || true
    ln -sf "$APP_DIR/pkg" "$INSTALL_BIN/jarvis-kids" 2>/dev/null || true
  elif command -v sudo >/dev/null 2>&1; then
    sudo ln -sf "$APP_DIR/pkg" "$INSTALL_BIN/pkg" 2>/dev/null || true
    sudo ln -sf "$APP_DIR/pkg" "$INSTALL_BIN/jarvis-kids" 2>/dev/null || true
  else
    mkdir -p "$HOME/.local/bin"
    ln -sf "$APP_DIR/pkg" "$HOME/.local/bin/pkg" 2>/dev/null || true
    ln -sf "$APP_DIR/pkg" "$HOME/.local/bin/jarvis-kids" 2>/dev/null || true
  fi

  # Cria lançador de desktop apenas se pasta Desktop existir
  DESKTOP_DIR="$HOME/Desktop"
  [ ! -d "$DESKTOP_DIR" ] && DESKTOP_DIR="$HOME/Área de Trabalho"
  if [ -d "$DESKTOP_DIR" ]; then
    cat > "$DESKTOP_DIR/JARVIS_Kids.desktop" << EOF
[Desktop Entry]
Name=J.A.R.V.I.S. Kids OS
Comment=Sistema Educativo Infantil Stark
Exec=$APP_DIR/pkg start
Icon=$APP_DIR/static/icons/icon-192.png
Terminal=false
Type=Application
Categories=Education;KidsGame;
EOF
    chmod +x "$DESKTOP_DIR/JARVIS_Kids.desktop" 2>/dev/null || true
  fi

  chmod +x "$APP_DIR/pkg" "$APP_DIR"/*.sh 2>/dev/null || true

  echo -e "${YELLOW}🎉 [6/6] Verificando integridade da instalação...${NC}"
  echo -e "${GREEN}==================================================================${NC}"
  echo -e "${GREEN}   ✅ INSTALAÇÃO CONCLUÍDA COM SUCESSO!                          ${NC}"
  echo -e "${GREEN}==================================================================${NC}"
  echo -e "Você agora pode usar o comando ${BOLD}pkg${NC} para controlar o sistema:\n"
  echo -e "   ${CYAN}pkg start${NC}    ➔ Iniciar o J.A.R.V.I.S. Kids OS"
  echo -e "   ${CYAN}pkg status${NC}   ➔ Verificar integridade, porta e consumo de RAM"
  echo -e "   ${CYAN}pkg stop${NC}     ➔ Parar o servidor"
  echo -e "   ${CYAN}pkg update${NC}   ➔ Atualizar o sistema com as últimas novidades"
  echo -e "\nPara abrir agora mesmo, execute: ${BOLD}./pkg start${NC} ou ${BOLD}pkg start${NC}\n"
}

cmd_start() {
  banner
  echo -e "${CYAN}🚀 Iniciando o J.A.R.V.I.S. Kids OS na porta ${PORT}...${NC}"
  cd "$APP_DIR"

  # Determina interpretador Python
  if [ -f "$APP_DIR/venv/bin/python" ]; then
    PY="$APP_DIR/venv/bin/python"
  else
    PY="python3"
  fi

  # Verifica e auto-corrige dependência microdot se necessário
  if ! "$PY" -c "import microdot" >/dev/null 2>&1; then
    echo -e "${YELLOW}⚠️ Dependência 'microdot' não detectada. Instalando rapidamente...${NC}"
    if [ -f "$APP_DIR/venv/bin/pip" ]; then
      "$APP_DIR/venv/bin/pip" install microdot bottle edge-tts requests google-genai --no-cache-dir || true
    else
      python3 -m pip install --break-system-packages microdot bottle edge-tts requests google-genai --no-cache-dir 2>/dev/null || \
      python3 -m pip install --user --break-system-packages microdot bottle edge-tts requests google-genai --no-cache-dir 2>/dev/null || \
      python3 -m pip install --user microdot bottle edge-tts requests google-genai --no-cache-dir 2>/dev/null || true
    fi
  fi

  # Limite estrito de RAM para Acer Aspire One 532 (1 GB RAM)
  export PYTHONOPTIMIZE=1
  export MALLOC_ARENA_MAX=2

  # Se o servidor não estiver rodando na porta alvo, inicia em segundo plano
  if ! pgrep -f "run_server.py.*$PORT" >/dev/null 2>&1 && ! pgrep -f "run_server.py" >/dev/null 2>&1; then
    nohup "$PY" "$APP_DIR/run_server.py" "$PORT" > "$APP_DIR/jarvis_server.log" 2>&1 &
    sleep 2
  fi

  # Valida se o servidor está ativo
  if pgrep -f "run_server.py" >/dev/null 2>&1; then
    PID=$(pgrep -f "run_server.py" | head -n1)
    echo -e "${GREEN}==================================================================${NC}"
    echo -e "${GREEN}   ✅ J.A.R.V.I.S. KIDS OS ATIVO COM SUCESSO (PID: ${PID})        ${NC}"
    echo -e "${GREEN}==================================================================${NC}"
    
    # Detecção de IP
    LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
    [ -z "$LOCAL_IP" ] && LOCAL_IP="127.0.0.1"

    echo -e "   🏠 Acesso Local:    ${BOLD}http://localhost:${PORT}${NC}"
    echo -e "   🌐 Acesso na Rede:  ${BOLD}http://${LOCAL_IP}:${PORT}${NC}"
    echo -e "   📱 Painel dos Pais: ${BOLD}http://${LOCAL_IP}:${PORT}/pais${NC}\n"

    # Se estiver com monitor gráfico ativo (X11 / Desktop), abre o navegador Kiosk em modo 1 GB RAM
    if [ -n "$DISPLAY" ]; then
      echo -e "${CYAN}🖥️ Interface gráfica detectada (${DISPLAY}). Abrindo quiosque (1 GB RAM)...${NC}"
      KIOSK_FLAGS="--kiosk --disable-gpu --disable-dev-shm-usage --renderer-process-limit=1 --js-flags=--max-old-space-size=192 --disable-extensions --disable-background-networking --disk-cache-size=10485760"
      if command -v chromium >/dev/null 2>&1; then
        chromium $KIOSK_FLAGS --app="http://127.0.0.1:${PORT}" &
      elif command -v chromium-browser >/dev/null 2>&1; then
        chromium-browser $KIOSK_FLAGS --app="http://127.0.0.1:${PORT}" &
      elif command -v firefox-esr >/dev/null 2>&1; then
        firefox-esr --kiosk "http://127.0.0.1:${PORT}" &
      elif command -v firefox >/dev/null 2>&1; then
        firefox --kiosk "http://127.0.0.1:${PORT}" &
      fi
    else
      echo -e "${YELLOW}☁️ Modo Headless / Servidor VPS ativo (sem monitor conectado).${NC}"
      echo -e "O Jarvis está rodando em segundo plano e pronto para receber acessos!"
      echo -e "Acompanhe os logs com: ${BOLD}tail -f ${APP_DIR}/jarvis_server.log${NC}"
    fi
  else
    echo -e "${RED}❌ Erro ao iniciar o servidor! Verifique o log em: ${APP_DIR}/jarvis_server.log${NC}"
    if [ -f "$APP_DIR/jarvis_server.log" ]; then
      echo -e "${YELLOW}Últimas linhas do log:${NC}"
      tail -n 12 "$APP_DIR/jarvis_server.log"
    fi
  fi
}

cmd_stop() {
  echo -e "${YELLOW}🛑 Encerrando o J.A.R.V.I.S. Kids OS...${NC}"
  pkill -f "run_server.py $PORT" 2>/dev/null || true
  pkill -f "run_server.py" 2>/dev/null || true
  sleep 1
  echo -e "${GREEN}✅ Servidor encerrado.${NC}"
}

cmd_status() {
  banner
  echo -e "🔍 Verificando status do sistema:"
  if pgrep -f "run_server.py" >/dev/null 2>&1; then
    PID=$(pgrep -f "run_server.py" | head -n1)
    MEM=$(ps -o rss= -p "$PID" 2>/dev/null | awk '{printf "%.1f MB", $1/1024}' || echo "N/A")
    LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
    echo -e "   Servidor:   ${GREEN}ATIVO (PID: ${PID})${NC}"
    echo -e "   Porta:      ${GREEN}http://127.0.0.1:${PORT}${NC}"
    echo -e "   IP na Rede: ${GREEN}http://${LOCAL_IP}:${PORT}${NC}"
    echo -e "   Memória:    ${GREEN}${MEM}${NC}"
  else
    echo -e "   Servidor:   ${RED}PARADO${NC}"
    echo -e "   Dica:       Execute ${CYAN}pkg start${NC} para iniciar."
  fi
}

cmd_update() {
  banner
  echo -e "${YELLOW}🔄 Atualizando o J.A.R.V.I.S. Kids OS para a versão mais recente...${NC}"
  cd "$APP_DIR"
  if [ -d ".git" ]; then
    git pull origin main || true
  else
    echo -e "${YELLOW}Repositório Git não detectado. Baixando arquivos mais recentes...${NC}"
  fi
  echo -e "${GREEN}✅ Atualização concluída com sucesso!${NC}"
}

cmd_harden() {
  banner
  INTENSIDADE="${2:-balanced}"
  echo -e "${CYAN}🛡️ Gerando release blindada com Blind LLM Agents (Intensidade: ${INTENSIDADE})...${NC}"
  cd "$APP_DIR"
  if [ -f "$APP_DIR/venv/bin/python" ]; then
    "$APP_DIR/venv/bin/python" "$APP_DIR/scripts/blindar_release_bla.py" --intensity "$INTENSIDADE"
  else
    python3 "$APP_DIR/scripts/blindar_release_bla.py" --intensity "$INTENSIDADE"
  fi
}

cmd_help() {
  banner
  echo -e "Uso: ${BOLD}pkg <comando>${NC} ou ${BOLD}./pkg <comando>${NC}\n"
  echo -e "Comandos disponíveis:"
  echo -e "  ${CYAN}install${NC}   Instala todas as dependências essenciais do sistema (Padrão)"
  echo -e "  ${CYAN}start${NC}     Inicia o servidor em segundo plano e abre navegador (se desktop)"
  echo -e "  ${CYAN}stop${NC}      Encerra o servidor com segurança"
  echo -e "  ${CYAN}status${NC}    Exibe o status do servidor, uso de memória RAM e porta"
  echo -e "  ${CYAN}update${NC}    Atualiza o código com a versão mais recente do GitHub"
  echo -e "  ${CYAN}harden${NC}    Gera release blindada Counter-REA (Blind LLM Agents) em dist/"
  echo -e "  ${CYAN}help${NC}      Exibe este menu de ajuda\n"
}

case "$ACTION" in
  install|i|setup)
    cmd_install
    ;;
  start|run|launch)
    cmd_start
    ;;
  stop|kill)
    cmd_stop
    ;;
  status|info)
    cmd_status
    ;;
  update|upgrade)
    cmd_update
    ;;
  harden|blindar|bla)
    cmd_harden "$@"
    ;;
  help|-h|--help)
    cmd_help
    ;;
  *)
    cmd_help
    ;;
esac
